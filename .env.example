# ============================================================
#  RAG 检索系统 · Docker Compose 环境变量
#  用法：cp .env.example .env，然后填写所有【必填】项。
#  .env 已被 Git 忽略；生产服务器请执行 chmod 600 .env。
# ============================================================

# ─── Compose 与访问入口 ─────────────────────────────────────
# 固定项目名后，即使更换部署目录也会继续使用 rag_pg_data / rag_upload_data。
# 同一服务器部署测试/生产多套环境时必须使用不同名称；已产生数据后不要随意修改。
COMPOSE_PROJECT_NAME=rag
IMAGE_TAG=latest

# 0.0.0.0 表示可通过 http://服务器IP:8001 访问。
# 公网正式部署使用宿主机 Caddy/Nginx 提供 HTTPS 时，请改成 127.0.0.1。
APP_BIND_HOST=0.0.0.0
APP_PORT=8001

# PostgreSQL 只绑定宿主机环回地址；不要改成 0.0.0.0。
# 本地运行后端时连接 127.0.0.1:5433，容器内始终连接 postgres:5432。
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_HOST_PORT=5433

# 国内默认使用清华 PyPI 镜像；海外服务器可改为 https://pypi.org/simple。
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# ─── PostgreSQL ─────────────────────────────────────────────
POSTGRES_USER=rag
# 【必填】先执行 openssl rand -hex 24，再把结果粘贴到这里。
# 当前连接串未做 URL 编码，因此只使用字母和数字。
POSTGRES_PASSWORD=
POSTGRES_DB=rag_prod

# Docker 部署不要设置 DATABASE_URL，Compose 会自动指向 postgres 容器。
# 仅在宿主机直接运行后端时，通过终端 export：
# DATABASE_URL=postgresql+asyncpg://rag:你的密码@127.0.0.1:5433/rag_prod

# ─── 安全 ───────────────────────────────────────────────────
# 【必填】执行 openssl rand -hex 32 后粘贴结果。
JWT_SECRET=
# 【必填】初始管理员 admin 的密码；只在数据库第一次初始化时生效。
ADMIN_INIT_PASSWORD=
# ACCESS_TOKEN_EXPIRE_MINUTES=720

# ─── 模型配置 ───────────────────────────────────────────────
# 可留空，部署后在「系统设置」中填写。全部使用 OpenAI 兼容接口。
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4o
# TEMPERATURE=0.7
# MAX_TOKENS=2048

# 数据库向量列固定为 2560 维，模型接口必须实际返回 2560 维。
# 当前请求不会主动向兼容接口传 dimensions，仅填写维度变量不能改变模型输出。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=

# 多模态模型可选；不上传图片时可以留空。
VISION_API_KEY=
VISION_BASE_URL=https://api.openai.com/v1
VISION_MODEL=gpt-4o

# ─── 检索参数（可选）────────────────────────────────────────
# TOP_K=5
# RERANK_ENABLED=true
# SHOW_SOURCES=true

# ─── 站点品牌（可选，也可在后台设置）────────────────────────
# SITE_TITLE=RAG 检索系统
# SITE_DESCRIPTION=知识增强·精准问答
# BROWSER_TITLE=
# SITE_COPYRIGHT=© 2026 你的公司名称
