# ============================================================
#  RAG 检索系统 · Docker Compose 环境变量
#  用法：cp .env.example .env，然后填写所有【必填】项。
#  .env 已被 Git 忽略；生产服务器请执行 chmod 600 .env。
# ============================================================

# ─── Compose 与访问入口 ─────────────────────────────────────
# 固定项目名后，即使更换部署目录也会继续使用 rag_pg_data / rag_upload_data。
# 同一服务器部署测试/生产多套环境时必须使用不同名称；已产生数据后不要随意修改。
COMPOSE_PROJECT_NAME=rag
# 应用镜像已固定为阿里云 ACR 的 easylau/rag；首次部署可使用 latest，生产环境建议固定版本号。
# 例如发布 v1.2.3 后填写 1.2.3；升级时只修改此值并执行 docker compose pull && docker compose up -d。
IMAGE_TAG=latest

# 0.0.0.0 表示可通过 http://服务器IP:8001 访问。
# 公网正式部署使用宿主机 Caddy/Nginx 提供 HTTPS 时，请改成 127.0.0.1。
APP_BIND_HOST=0.0.0.0
APP_PORT=8001

# Docker 默认按生产环境运行：保留结构化算法指标，但不把完整问题、回答和知识片段
# 写入容器日志。仅在受控开发/调试环境改为 development，或显式开启正文追踪。
APP_ENV=production
# LOG_LEVEL=INFO
# RAG_TRACE_ENABLED=true
# RAG_TRACE_CONTENT_ENABLED=false
# RAG_TRACE_CANDIDATE_DETAILS_ENABLED=false
# RAG_TRACE_CONTENT_MAX_CHARS=50000
# RAG_TRACE_PERSISTENCE_ENABLED=true
# RAG_TRACE_RETENTION_DAYS=30
# RAG_TRACE_QUEUE_SIZE=500
# RAG_TRACE_MAX_EVENT_BYTES=131072
# RAG_TRACE_MAX_EVENTS_PER_RUN=500
# RAG v2 是默认主链；需要紧急回滚时改为 v1 并重启，无需数据库迁移。
# 语义理解入口独立于证据执行器；默认 v3，legacy 仅用于紧急兼容回滚。
RAG_SEMANTIC_ENTRY=v3
# V3 模型只选择服务端签发的 span；超时/容量满时保守回退本地计划。
RAG_QUERY_UNDERSTANDING_V3_MODE=active
RAG_QUERY_UNDERSTANDING_V3_ACTIVE_TIMEOUT_SECONDS=2.5
RAG_QUERY_UNDERSTANDING_V3_ACTIVE_MAX_INFLIGHT=2
# 仅在 V3 理解阶段预取 immutable anchor；最终任务图仍重新做准入。
RAG_QUERY_UNDERSTANDING_V3_ANCHOR_PREFETCH_ENABLED=true
RAG_QUERY_UNDERSTANDING_V3_ANCHOR_PREFETCH_TIMEOUT_SECONDS=2.5
# 语义路由主模型、格式兼容重试和备用模型共用的总期限；超时后安全回退为查库。
RAG_ROUTE_TIMEOUT_SECONDS=12
# RAG v2 检索/扩展阶段期限及共享总期限（秒）；后续阶段只使用剩余预算，
# 扩展超时会保留首轮证据并标记 degraded。
RAG_V2_RETRIEVAL_TIMEOUT_SECONDS=15
RAG_V2_EXPANSION_TIMEOUT_SECONDS=8
RAG_V2_RETRIEVAL_WORKFLOW_TIMEOUT_SECONDS=22
# V2 先执行确定性证据闭合，仅在无法闭合时对已授权且受候选预算限制的证据
# 启用结构化模型裁判。模型只能判断片段的答案支撑度，不能扩大 KB/文档范围
# 或绕过最终证据校验；失败时保留确定性证据链。设为 false 可快速降级为
# 纯确定性模式。
RAG_V2_MODEL_EVIDENCE_ADJUDICATION_ENABLED=true
# 可选：设置后单独限制证据判定耗时；未设置时继承 LLM_REQUEST_TIMEOUT_SECONDS。
# RAG_V2_MODEL_EVIDENCE_ADJUDICATION_TIMEOUT_SECONDS=30
# 最终回答的建流、首分片前重试、退避和流读取共享此总期限，避免 3 次各耗满 60 秒。
RAG_V2_GENERATION_WORKFLOW_TIMEOUT_SECONDS=60

# 文档上传接口只落库入队；独立 document-worker 领取并处理。任务可在 worker
# 重启后恢复。lease 应覆盖一次最大解析、视觉识别和 embedding 的总耗时。
# DOCUMENT_JOB_MAX_ATTEMPTS=3
# DOCUMENT_JOB_LEASE_SECONDS=900
# DOCUMENT_JOB_POLL_SECONDS=1.0
# 本地 uvicorn 默认会托管 worker；生产 Compose 默认由 Supervisor 独立托管。
# DOCUMENT_JOB_EMBEDDED_WORKER=true

# PostgreSQL 只绑定宿主机环回地址；不要改成 0.0.0.0。
# 本地运行后端时连接 127.0.0.1:5433，容器内始终连接 postgres:5432。
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_HOST_PORT=5433

# ─── PostgreSQL ─────────────────────────────────────────────
POSTGRES_USER=rag
# 【必填】先执行 openssl rand -hex 24，再把结果粘贴到这里。
# 当前连接串未做 URL 编码，因此只使用字母和数字。
POSTGRES_PASSWORD=
POSTGRES_DB=rag_prod

# Docker 部署不要设置 DATABASE_URL，Compose 会自动指向 postgres 容器。
# 仅在宿主机直接运行后端时，通过终端 export：
# DATABASE_URL=postgresql+asyncpg://rag:你的密码@127.0.0.1:5433/rag_prod

# ─── 安全 ───────────────────────────────────────────────────
# 【必填】执行 openssl rand -hex 32 后粘贴结果。
JWT_SECRET=
# 【必填】执行 openssl rand -hex 32 后粘贴结果；用于加密数据库 settings 表中的模型 API Key。
# 此值必须与数据库备份分开安全保管，丢失后无法解密已保存的模型密钥。
CONFIG_ENCRYPTION_KEY=
# 【必填】初始管理员 admin 的密码；只在数据库第一次初始化时生效。
ADMIN_INIT_PASSWORD=
# ACCESS_TOKEN_EXPIRE_MINUTES=720

# 登录防爆破参数（可选，以下均为默认值）。系统只限制攻击来源，不会因为外部失败
# 全局锁定 admin 或其他账号：同一 IP + 用户名失败 5 次后限制该组合 15 分钟；
# 同一 IP 在 15 分钟内累计失败 20 次后限制该 IP 60 分钟；账号集中失败仅告警。
# LOGIN_PAIR_FAILURE_THRESHOLD=5
# LOGIN_PAIR_WINDOW_MINUTES=15
# LOGIN_PAIR_BLOCK_MINUTES=15
# LOGIN_IP_FAILURE_THRESHOLD=20
# LOGIN_IP_WINDOW_MINUTES=15
# LOGIN_IP_BLOCK_MINUTES=60
# LOGIN_ACCOUNT_ALERT_THRESHOLD=20
# LOGIN_ACCOUNT_ALERT_WINDOW_MINUTES=15
# LOGIN_THROTTLE_RETENTION_HOURS=48
# LOGIN_LOG_AGGREGATE_SECONDS=60
# LOGIN_LOG_RETENTION_DAYS=90

# 仅当 8001 前面还有宿主机 Nginx/Caddy/CDN 时填写其来源 IP/CIDR，多个值用逗号分隔。
# 不要填写 0.0.0.0/0；留空时容器不会信任任何外部 X-Forwarded-For。
# 示例（请按服务器实际网络收窄）：TRUSTED_PROXY_CIDRS=172.23.0.1/32
TRUSTED_PROXY_CIDRS=

# ─── 首次后台初始化 ──────────────────────────────────────────
# LLM / Embedding / Vision 的 API Key、Base URL、模型名、检索参数和站点品牌
# 均不写入 .env。启动后以管理员身份进入「管理后台 → 模型管理」填写模型配置，
# 检索参数和站点品牌仍在「系统设置」中维护；API Key 会加密保存到 PostgreSQL，
# 并在保存后立即生效。
# 数据库向量列固定为 2560 维，请在保存 Embedding 配置前先使用后台“测试当前填写”确认维度。
