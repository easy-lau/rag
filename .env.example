# ============================================================
#  RAG 检索系统 · 环境变量配置
#  用法：cp .env.example .env  然后修改下面的值（.env 已被 gitignore，勿提交）
#  标【必填】的务必改；其余可用默认值，或部署后在「设置」页里填。
# ============================================================

# ─── 数据库 PostgreSQL ───────────────────────────────────────
# docker compose 用这三个变量启动数据库，并自动拼接后端的 DATABASE_URL（指向 postgres 容器）。
# 【必填】POSTGRES_PASSWORD：⚠️ 只用字母和数字！不要含 @ : / ? # % & 空格 等符号——
#         这些符号会破坏数据库连接串，导致后端连不上库、反复重启（就是之前那个报错）。
POSTGRES_USER=rag
POSTGRES_PASSWORD=ChangeMe_LettersAndDigitsOnly_9f3k2p7q
POSTGRES_DB=rag_db

# 仅当你「不用 docker、在本机直接跑后端」时才设置 DATABASE_URL；
# docker 部署请保持注释——compose 会自动指向 postgres 容器（host=postgres）。
# DATABASE_URL=postgresql+asyncpg://rag:你的密码@localhost:5433/rag_db

# ─── 安全（生产务必修改）─────────────────────────────────────
# 【必填】JWT 签名密钥：随机长字符串。用默认值会导致登录令牌可被伪造。
#         生成示例：openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string_use_openssl_rand_hex_32
# 【必填】初始管理员密码：首次初始化数据库时写入；登录用户名固定为 admin。
#         注意：只在「数据库第一次初始化」时生效，之后改这里不会改已存在的 admin 密码。
ADMIN_INIT_PASSWORD=change_me_admin_password
# 登录令牌有效期（分钟），默认 720（12 小时）
# ACCESS_TOKEN_EXPIRE_MINUTES=720

# ─── 模型配置 ───────────────────────────────────────────────
# 以下模型项可留空，部署后在「设置」页里填（推荐）；若在此填写则作为默认值。
# 全部走 OpenAI 兼容接口：api_key + base_url + 模型名。

# 大语言模型（对话）
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4o
# TEMPERATURE=0.7
# MAX_TOKENS=2048

# 向量模型（Embedding）
# ⚠️ 该模型输出的向量维度必须是 2560（数据库向量列固定为 2560 维）。
#    若你的模型不是 2560 维，要换模型或重建向量列（改维度涉及数据库迁移，别随意改）。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=
# EMBEDDING_DIMENSIONS=2560

# 多模态模型（图片/截图识别，可选；不传图片可不配）
VISION_API_KEY=
VISION_BASE_URL=https://api.openai.com/v1
VISION_MODEL=gpt-4o

# ─── 检索参数（可选，一般用默认）────────────────────────────
# TOP_K=5
# RERANK_ENABLED=true
# SHOW_SOURCES=true

# ─── 站点品牌（可选，也可在「设置」页改）──────────────────────
# SITE_TITLE=RAG 检索系统
# SITE_DESCRIPTION=知识增强·精准问答
# BROWSER_TITLE=
# SITE_COPYRIGHT=© 2026 你的公司名称
